{
  "name": "dofus-combo-simulator",
  "version": "1.0.0",
  "description": "Outil open source de theorycraft Dofus permettant de comparer les degats moyens de differents stuffs et combos de sorts.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:stuff": "tsx src/main.ts --stuff 69f6a4074304cd0013621863",
    "dev:compare:basic": "tsx src/main.ts --combo basic-combo-1 --compare-stuffs 69f6a4074304cd0013621863,69f6aad50e790800141dfb88",
    "dev:watch": "nodemon",
    "dev:watch:stuff": "nodemon --exec \"tsx src/main.ts --stuff 69f6a4074304cd0013621863\"",
    "dev:watch:compare:basic": "nodemon --exec \"tsx src/main.ts --combo basic-combo-1 --compare-stuffs 69f6a4074304cd0013621863,69f6aad50e790800141dfb88\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paullebras/dofus-combo-simulator.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "devDependencies": {
    "@types/node": "^20.12.7",
    "nodemon": "^3.1.10",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "bugs": {
    "url": "https://github.com/paullebras/dofus-combo-simulator/issues"
  },
  "homepage": "https://github.com/paullebras/dofus-combo-simulator#readme"
}
